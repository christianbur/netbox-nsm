{% extends 'generic/object.html' %}
{% load i18n %}
{% load helpers %}

{% block content %}
<div class="card">
  <div class="card-body p-0">
    {% if is_matrix %}
      <div class="card-header d-flex align-items-center gap-2">
        <i class="mdi mdi-table-large"></i>
        <strong>{% trans "Zone Policy Matrix" %}</strong>
        <span class="text-muted ms-2 small">
          {% trans "Rows = Source · Columns = Destination · Click a cell to set or change the policy" %}
        </span>
      </div>

      <div class="card mb-3 border-0 border-bottom rounded-0">
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-2">
            <i class="mdi mdi-filter-outline"></i>
            <strong>{% trans "Filter" %}</strong>
            {% if source_zone_ids or destination_zone_ids or policy_ids %}
              <span class="badge text-bg-primary">{% trans "Active" %}</span>
            {% endif %}
          </div>
          <button class="btn btn-sm btn-outline-secondary"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#security-policy-matrix-filters"
                  aria-expanded="{% if source_zone_ids or destination_zone_ids or policy_ids %}true{% else %}false{% endif %}"
                  aria-controls="security-policy-matrix-filters">
            <i class="mdi mdi-unfold-more-horizontal"></i>
            {% trans "Show/Hide" %}
          </button>
        </div>
        <div id="security-policy-matrix-filters" class="collapse{% if source_zone_ids or destination_zone_ids or policy_ids %} show{% endif %}">
        <div class="card-body">
          <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
              <label class="form-label mb-1">{% trans "Source Zone" %}</label>
              <select name="source_zone_id" class="form-select" multiple size="8">
                {% for zone in filter_zone_options %}
                  <option value="{{ zone.pk }}"{% if zone.pk|stringformat:"s" in source_zone_ids %} selected{% endif %}>{{ zone.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label mb-1">{% trans "Destination Zone" %}</label>
              <select name="destination_zone_id" class="form-select" multiple size="8">
                {% for zone in filter_zone_options %}
                  <option value="{{ zone.pk }}"{% if zone.pk|stringformat:"s" in destination_zone_ids %} selected{% endif %}>{{ zone.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label mb-1">{% trans "Policy" %}</label>
              <select name="policy_id" class="form-select" multiple size="8">
                {% for pol in filter_policy_options %}
                  <option value="{{ pol.pk }}"{% if pol.pk|stringformat:"s" in policy_ids %} selected{% endif %}>{{ pol.name }} ({{ pol.policy_action }})</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-sm btn-primary">
                <i class="mdi mdi-magnify"></i> {% trans "Apply" %}
              </button>
              <a href="." class="btn btn-sm btn-outline-secondary">
                <i class="mdi mdi-close"></i> {% trans "Reset" %}
              </a>
            </div>
          </form>
        </div>
        </div>
      </div>

      {% if not source_zones %}
        <div class="alert alert-info m-3">
          <i class="mdi mdi-information-outline me-1"></i>
          {% blocktrans %}
            No security zones found for this matrix.
            Make sure a security zone role is assigned to this security policy
            and at least one security zone exists for that role.
          {% endblocktrans %}
        </div>
      {% else %}
      <style>
        .nbs-matrix th.nbs-zone-label {
          writing-mode: vertical-rl;
          transform: rotate(180deg);
          white-space: nowrap;
          text-align: left;
          vertical-align: bottom;
          padding: 6px 8px;
          font-weight: 600;
          font-size: .8rem;
          max-width: 36px;
          min-width: 36px;
        }
        .nbs-matrix th.nbs-row-label {
          white-space: nowrap;
          font-weight: 600;
          font-size: .8rem;
          padding: 4px 10px;
          vertical-align: middle;
          text-align: right;
        }
        .nbs-matrix td.nbs-cell {
          padding: 3px;
          text-align: center;
          vertical-align: middle;
          min-width: 72px;
          max-width: 110px;
        }
        .nbs-matrix td.nbs-cell a.nbs-policy-btn {
          display: block;
          border-radius: 4px;
          padding: 4px 6px;
          font-size: .78rem;
          font-weight: 700;
          text-decoration: none;
          line-height: 1.3;
          word-break: break-word;
        }
        .nbs-matrix td.nbs-cell a.nbs-add-btn {
          display: block;
          border-radius: 4px;
          padding: 4px 3px;
          color: #adb5bd;
          font-size: 1rem;
          text-decoration: none;
          border: 1px dashed #dee2e6;
          line-height: 1;
          transition: all .15s;
        }
        .nbs-matrix td.nbs-cell a.nbs-add-btn:hover {
          color: #0d6efd;
          border-color: #0d6efd;
          background: rgba(13,110,253,.06);
        }
        .nbs-matrix td.nbs-cell a.nbs-policy-btn:hover {
          opacity: .82;
          filter: brightness(1.08);
        }
        .nbs-matrix td.nbs-self {
          background: repeating-linear-gradient(
            45deg, #f8f9fa, #f8f9fa 4px, #e9ecef 4px, #e9ecef 8px
          );
        }
      </style>

      <div class="table-responsive">
        <table class="table table-bordered table-sm mb-0 nbs-matrix">
          <thead>
            <tr>
              <th class="nbs-row-label" style="text-align:center">
                <span class="text-muted d-inline-block" style="font-size:.68rem;line-height:1.1;text-align:center;width:100%">
                  Destination →<br>Source ↓
                </span>
              </th>
              {% for dz in destination_zones %}
                <th class="nbs-zone-label" title="{{ dz.name }}">
                  <a href="?destination_zone_id={{ dz.pk }}" style="color:inherit;text-decoration:underline dotted;">
                    {{ dz.name }}
                  </a>
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in matrix_rows %}
            <tr>
              <th class="nbs-row-label">
                <a href="?source_zone_id={{ row.source_zone.pk }}" style="color:inherit;text-decoration:underline dotted;">
                  {{ row.source_zone.name }}
                </a>
              </th>
              {% for item in row.cells %}
              <td class="nbs-cell{% if row.source_zone.pk == item.destination_zone.pk %} nbs-self{% endif %}">
                {% if item.cell %}
                  <a href="{% url 'plugins:netbox_nsm:securityzonepolicyrule' item.cell.pk %}"
                     class="nbs-policy-btn text-bg-{{ item.cell.color }}"
                     title="{{ row.source_zone.name }} → {{ item.destination_zone.name }}: {{ item.cell.name }} ({{ item.cell.policy_action }}) - click to edit">
                    {{ item.cell.name }}
                  </a>
                {% elif row.source_zone.pk == item.destination_zone.pk %}
                  <span class="text-muted">—</span>
                {% else %}
                  <a href="{% url 'plugins:netbox_nsm:securityzonepolicyrule_add' %}?rulebook={{ object.pk }}&source_zones={{ row.source_zone.pk }}&destination_zones={{ item.destination_zone.pk }}"
                     class="nbs-add-btn"
                     title="{{ row.source_zone.name }} → {{ item.destination_zone.name }}: set policy">
                    <i class="mdi mdi-plus"></i>
                  </a>
                {% endif %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if policy_legend %}
      <div class="d-flex flex-wrap gap-2 p-3 border-top align-items-center">
        <span class="text-muted me-1 small fw-semibold">{% trans "Legend:" %}</span>
        {% for pol in policy_legend %}
          <a href="{{ pol.get_absolute_url }}"
             class="badge text-bg-{{ pol.color }} text-decoration-none">
            {{ pol.name }} ({{ pol.policy_action }})
          </a>
        {% endfor %}
        <span class="ms-3 text-muted small">
          <span class="border border-dashed rounded px-1 text-muted" style="border-style:dashed!important">+</span>
          {% trans "= not set — click to assign a policy" %}
          &nbsp;·&nbsp;
          <span class="text-muted fst-italic">—</span>
          {% trans "= same zone (ignored)" %}
        </span>
      </div>
      {% endif %}
      {% endif %}
    {% else %}
      <div class="p-3">
        {% if is_security_rules %}
          <style>
            .nsm-policy-table .table {
              --bs-table-bg: transparent;
              margin-bottom: 0;
            }
            .nsm-policy-table .table thead th {
              background: linear-gradient(180deg, #f8f4ed 0%, #f1ebe1 100%);
              border-bottom-width: 1px;
              color: #4c3f2f;
              font-size: .78rem;
              font-weight: 700;
              letter-spacing: .04em;
              text-transform: uppercase;
              white-space: nowrap;
            }
            .nsm-policy-table .table tbody td {
              padding-top: .55rem;
              padding-bottom: .55rem;
              vertical-align: top;
            }
            .nsm-policy-table .table tbody tr:hover {
              --bs-table-accent-bg: rgba(140, 94, 47, .05);
            }
            .nsm-policy-table .table tbody td:nth-child(2),
            .nsm-policy-table .table tbody td:nth-child(3) {
              white-space: nowrap;
            }
            .nsm-policy-table .table tbody td:nth-child(3) {
              text-align: center;
            }
            .nsm-rule-stack {
              display: flex;
              flex-direction: row;
              flex-wrap: wrap;
              align-items: flex-start;
              gap: .3rem;
            }
            .nsm-rule-card {
              background: #fcfaf6;
              border: 1px solid #ece2d3;
              border-radius: .7rem;
              max-width: 100%;
              min-width: 0;
              padding: .28rem .4rem;
              box-shadow: inset 0 1px 0 rgba(255,255,255,.5);
            }
            .nsm-rule-label {
              color: #7c6a55;
              font-size: .58rem;
              font-weight: 700;
              letter-spacing: .08em;
              line-height: 1.1;
              margin-bottom: .18rem;
              text-transform: uppercase;
            }
            .nsm-rule-pills {
              display: flex;
              flex-wrap: wrap;
              gap: .24rem;
            }
            .nsm-rule-pill {
              background: #efe6da;
              border: 1px solid #e2d3bf;
              border-radius: 999px;
              color: #4b3d2f;
              display: inline-flex;
              align-items: center;
              font-size: .7rem;
              font-weight: 600;
              line-height: 1.15;
              padding: .2rem .45rem;
            }
            .nsm-rule-pill:hover {
              background: #e7dac7;
              color: #3e3227;
            }
            .nsm-rule-pill-zone {
              border-color: rgba(255,255,255,.24);
              box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
              font-weight: 700;
            }
            .nsm-rule-pill-accent {
              background: #d7eadc;
              border-color: #bdd5c3;
              color: #204e2d;
            }
            .nsm-rule-pill-success {
              background: #d9f1df;
              border-color: #b6debf;
              color: #215a2f;
            }
            .nsm-rule-pill-muted {
              background: #ece9e4;
              border-color: #ddd7cf;
              color: #6b6257;
            }
            .nsm-status-icon {
              align-items: center;
              border-radius: 999px;
              display: inline-flex;
              height: 1.6rem;
              justify-content: center;
              width: 1.6rem;
            }
            .nsm-status-icon i {
              font-size: 1rem;
              line-height: 1;
            }
            .nsm-status-icon-on {
              background: #d9f1df;
              color: #1f7a33;
            }
            .nsm-status-icon-off {
              background: #f3e0df;
              color: #a63a32;
            }
          </style>
          <div class="mb-3 d-flex align-items-center justify-content-between gap-2">
            <strong>{% trans "Security Rules" %}</strong>
            {% if perms.netbox_nsm.add_securityzonepolicyrule %}
              <a href="{% url 'plugins:netbox_nsm:securityzonepolicyrule_add' %}?rulebook={{ object.pk }}&return_url={{ request.path|urlencode }}" class="btn btn-sm btn-primary">
                <span class="mdi mdi-plus-thick" aria-hidden="true"></span> {% trans "Add Rule" %}
              </a>
            {% endif %}
          </div>
          <div class="mb-3 text-muted small">
            {% trans "Configure visible columns on the main Security Policy page." %}
          </div>
        {% endif %}
        <div class="nsm-policy-table">
          {% include 'htmx/table.html' %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
